<?xml version="1.0" encoding="utf-8"?>
<!-- Светлая монотонная тема в духе Google Pixel: без теней, без градиентов,
     один синий акцент. -->
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:textColorPrimary">#1F1F1F</item>
        <item name="android:textColorSecondary">#5F6368</item>
        <item name="android:colorControlActivated">#1A73E8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
